<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="deli" name="Arquitetura DeliMarket + AWS"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="1780" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="zu" value="ZONA DE USUÁRIOS (VLAN)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#78B48C;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=14;fontColor=#78B48C;" parent="1" vertex="1"><mxGeometry x="10" y="250" width="280" height="540" as="geometry" /></mxCell><mxCell id="dc" value="DATA CENTER LOCAL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1E1E1E;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=14;fontColor=#1E1E1E;" parent="1" vertex="1"><mxGeometry x="330" y="100" width="1370" height="1080" as="geometry" /></mxCell><mxCell id="za" value="ZONA DE APLICAÇÃO (VLAN)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#78B48C;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=14;fontColor=#78B48C;" parent="1" vertex="1"><mxGeometry x="620" y="165" width="560" height="615" as="geometry" /></mxCell><mxCell id="zd" value="ZONA DE DADOS (VLAN)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#78B48C;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=14;fontColor=#78B48C;" parent="1" vertex="1"><mxGeometry x="1200" y="375" width="270" height="550" as="geometry" /></mxCell><mxCell id="bk" value="BACKUP 3-2-1 (+1 imutável, 0 erros)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1E1E1E;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=14;fontColor=#1E1E1E;" parent="1" vertex="1"><mxGeometry x="1780" y="40" width="880" height="410" as="geometry" /></mxCell><mxCell id="nv" value="NUVEM – CONTINGÊNCIA  (AWS, região sa-east-1 São Paulo)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1E1E1E;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=14;fontColor=#1E1E1E;" parent="1" vertex="1"><mxGeometry x="1780" y="480" width="880" height="480" as="geometry" /></mxCell><mxCell id="an" value="CAMADA ANALÍTICA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1E1E1E;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=14;fontColor=#1E1E1E;" parent="1" vertex="1"><mxGeometry x="1780" y="990" width="880" height="340" as="geometry" /></mxCell><mxCell id="sec" value="SEGURANÇA, IDENTIDADE E AUDITORIA  (novo, exceto o KMS que eles já previam)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0FBF4;strokeColor=#167846;strokeWidth=3;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=14;fontColor=#167846;" parent="1" vertex="1"><mxGeometry x="330" y="1395" width="2330" height="330" as="geometry" /></mxCell><mxCell id="e9" value="DeliMarket — arquitetura proposta com tecnologias (AWS)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16.8;fontColor=#1E1E1E;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="30" y="15" width="1900" height="45" as="geometry" /></mxCell><mxCell id="e10" value="Mesmo desenho da equipe DeliMarket (Diagrama 1); em verde, o que a consultoria acrescenta, já com os serviços. Premissa: AWS em sa-east-1 (LGPD e latência); alternativas no documento 09." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=15;fontColor=#6E6E6E;" parent="1" vertex="1"><mxGeometry x="30" y="60" width="2500" height="30" as="geometry" /></mxCell><mxCell id="e11" value="OPERAÇÃO" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#1E1E1E;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="10" y="212" width="200" height="24" as="geometry" /></mxCell><mxCell id="e12" value="segmentação por VLAN + firewall, 'negar por padrão' [AC13]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#167846;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="345" y="128" width="800" height="24" as="geometry" /></mxCell><mxCell id="e13" value="Eventos de todos os componentes seguem em tempo real para o coletor (a origem só envia, não apaga). Administração do coletor segregada da infraestrutura." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#167846;" parent="1" vertex="1"><mxGeometry x="360" y="1640" width="2250" height="28" as="geometry" /></mxCell><mxCell id="e14" value="Zonas: usuários · aplicação · dados · backup isolado · gerência/segurança · visitantes. Regras 'negar por padrão', administração só pelo bastion." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#167846;" parent="1" vertex="1"><mxGeometry x="360" y="1675" width="2250" height="28" as="geometry" /></mxCell><mxCell id="e15" value="" style="rounded=1;html=1;fillColor=none;strokeColor=#1E1E1E;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="10" y="100" width="308" height="100" as="geometry" /></mxCell><mxCell id="e16" value="" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#1E1E1E;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="22" y="112" width="40" height="24" as="geometry" /></mxCell><mxCell id="e17" value="já na proposta deles" style="text;html=1;align=left;fontSize=14;" parent="1" vertex="1"><mxGeometry x="72" y="112" width="240" height="24" as="geometry" /></mxCell><mxCell id="e18" value="" style="rounded=1;html=1;fillColor=#D6F1DF;strokeColor=#167846;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="22" y="152" width="40" height="24" as="geometry" /></mxCell><mxCell id="e19" value="novo (ACxx = ação do plano de ação)" style="text;html=1;align=left;whiteSpace=wrap;fontSize=14;fontColor=#167846;" parent="1" vertex="1"><mxGeometry x="72" y="144" width="240" height="40" as="geometry" /></mxCell><mxCell id="vpnr" value="Acesso remoto e filiais: VPN (IPsec/WireGuard) + MFA&lt;br&gt;&lt;b&gt;[AC03, AC13]&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D6F1DF;strokeColor=#167846;strokeWidth=2;fontSize=13;fontColor=#167846;" parent="1" vertex="1"><mxGeometry x="30" y="290" width="240" height="110" as="geometry" /></mxCell><mxCell id="op" value="Funcionários / pedidos / estoque / logística" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E1E1E;strokeWidth=2;fontSize=16;fontColor=#1E1E1E;" parent="1" vertex="1"><mxGeometry x="30" y="450" width="240" height="110" as="geometry" /></mxCell><mxCell id="est" value="Estações: EDR, USB bloqueado por GPO, sem admin local, BitLocker&lt;br&gt;&lt;b&gt;[AC05, AC14, AC28]&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D6F1DF;strokeColor=#167846;strokeWidth=2;fontSize=13;fontColor=#167846;" parent="1" vertex="1"><mxGeometry x="30" y="620" width="240" height="150" as="geometry" /></mxCell><mxCell id="inet" value="Internet A e B + firewalls redundantes" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E1E1E;strokeWidth=2;fontSize=16;fontColor=#1E1E1E;" parent="1" vertex="1"><mxGeometry x="370" y="430" width="200" height="110" as="geometry" /></mxCell><mxCell id="lb1" value="Balanceador de carga" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E1E1E;strokeWidth=2;fontSize=16;fontColor=#1E1E1E;" parent="1" vertex="1"><mxGeometry x="650" y="430" width="190" height="90" as="geometry" /></mxCell><mxCell id="lb2" value="Balanceador 2 (HAProxy + Keepalived)&lt;br&gt;&lt;b&gt;[AC08]&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D6F1DF;strokeColor=#167846;strokeWidth=2;fontSize=13;fontColor=#167846;" parent="1" vertex="1"><mxGeometry x="650" y="580" width="190" height="90" as="geometry" /></mxCell><mxCell id="erpr" value="Servidor ERP RESERVA" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E1E1E;strokeWidth=2;fontSize=16;fontColor=#1E1E1E;" parent="1" vertex="1"><mxGeometry x="930" y="200" width="200" height="90" as="geometry" /></mxCell><mxCell id="erpp" value="Servidor ERP PRINCIPAL" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E1E1E;strokeWidth=2;fontSize=16;fontColor=#1E1E1E;" parent="1" vertex="1"><mxGeometry x="930" y="640" width="200" height="90" as="geometry" /></mxCell><mxCell id="ups" value="UPS + gerador único" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E1E1E;strokeWidth=2;fontSize=16;fontColor=#1E1E1E;" parent="1" vertex="1"><mxGeometry x="650" y="830" width="190" height="90" as="geometry" /></mxCell><mxCell id="gen" value="Ponto p/ gerador móvel + teste sob carga + desligamento ordenado pelo UPS&lt;br&gt;&lt;b&gt;[AC24]&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D6F1DF;strokeColor=#167846;strokeWidth=2;fontSize=13;fontColor=#167846;" parent="1" vertex="1"><mxGeometry x="650" y="950" width="280" height="120" as="geometry" /></mxCell><mxCell id="bd" value="Banco transacional principal" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E1E1E;strokeWidth=2;fontSize=16;fontColor=#1E1E1E;" parent="1" vertex="1"><mxGeometry x="1230" y="430" width="200" height="115" as="geometry" /></mxCell><mxCell id="bdl" value="Patroni (HA do PostgreSQL): réplica local, failover automático com fencing&lt;br&gt;&lt;b&gt;[AC22]&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D6F1DF;strokeColor=#167846;strokeWidth=2;fontSize=12;fontColor=#167846;" parent="1" vertex="1"><mxGeometry x="1215" y="615" width="230" height="130" as="geometry" /></mxCell><mxCell id="bda" value="Réplica com atraso (recovery_min_apply_delay 1–4 h)&lt;br&gt;&lt;b&gt;[AC22]&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D6F1DF;strokeColor=#167846;strokeWidth=2;fontSize=12;fontColor=#167846;" parent="1" vertex="1"><mxGeometry x="1225" y="780" width="210" height="125" as="geometry" /></mxCell><mxCell id="vpn" value="AWS Site-to-Site VPN (IPsec, 2 túneis) para a réplica; evoluir p/ Direct Connect&lt;br&gt;&lt;b&gt;[AC13]&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D6F1DF;strokeColor=#167846;strokeWidth=2;fontSize=12;fontColor=#167846;" parent="1" vertex="1"><mxGeometry x="1490" y="430" width="200" height="150" as="geometry" /></mxCell><mxCell id="full" value="Full semanal + incremental diário + WAL contínuo" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E1E1E;strokeWidth=2;fontSize=16;fontColor=#1E1E1E;" parent="1" vertex="1"><mxGeometry x="1800" y="130" width="200" height="120" as="geometry" /></mxCell><mxCell id="pgb" value="pgBackRest: full/incr/diff + arquivamento de WAL, AES-256, verificação&lt;br&gt;&lt;b&gt;[AC20]&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D6F1DF;strokeColor=#167846;strokeWidth=2;fontSize=12;fontColor=#167846;" parent="1" vertex="1"><mxGeometry x="1800" y="270" width="200" height="120" as="geometry" /></mxCell><mxCell id="c3" value="Cópia 3 – nuvem imutável" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E1E1E;strokeWidth=2;fontSize=16;fontColor=#1E1E1E;" parent="1" vertex="1"><mxGeometry x="2070" y="62" width="220" height="90" as="geometry" /></mxCell><mxCell id="c2" value="Cópia 2 – backup local dedicado" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E1E1E;strokeWidth=2;fontSize=16;fontColor=#1E1E1E;" parent="1" vertex="1"><mxGeometry x="2070" y="205" width="220" height="90" as="geometry" /></mxCell><mxCell id="fita" value="Fita offline semanal – proteção extra" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E1E1E;strokeWidth=2;fontSize=16;fontColor=#1E1E1E;" parent="1" vertex="1"><mxGeometry x="2350" y="205" width="160" height="90" as="geometry" /></mxCell><mxCell id="cofre" value="Amazon S3 com Object Lock (modo conformidade) + versionamento, em conta AWS de backup separada&lt;br&gt;&lt;b&gt;[AC04]&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D6F1DF;strokeColor=#167846;strokeWidth=2;fontSize=12;fontColor=#167846;" parent="1" vertex="1"><mxGeometry x="2330" y="50" width="310" height="120" as="geometry" /></mxCell><mxCell id="bsrv" value="Servidor pgBackRest em VLAN isolada, fora do AD, credenciais próprias&lt;br&gt;&lt;b&gt;[AC04, AC13]&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D6F1DF;strokeColor=#167846;strokeWidth=2;fontSize=12;fontColor=#167846;" parent="1" vertex="1"><mxGeometry x="2050" y="320" width="260" height="100" as="geometry" /></mxCell><mxCell id="fleit" value="Fita LTO criptografada: leitura semestral e drive fora do DC&lt;br&gt;&lt;b&gt;[AC20]&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D6F1DF;strokeColor=#167846;strokeWidth=2;fontSize=12;fontColor=#167846;" parent="1" vertex="1"><mxGeometry x="2350" y="320" width="290" height="100" as="geometry" /></mxCell><mxCell id="rep" value="Réplica do banco" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E1E1E;strokeWidth=2;fontSize=16;fontColor=#1E1E1E;" parent="1" vertex="1"><mxGeometry x="1800" y="540" width="220" height="100" as="geometry" /></mxCell><mxCell id="erpc" value="ERP de contingência" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E1E1E;strokeWidth=2;fontSize=16;fontColor=#1E1E1E;" parent="1" vertex="1"><mxGeometry x="2090" y="545" width="210" height="90" as="geometry" /></mxCell><mxCell id="fo" value="Failover / Failback" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E1E1E;strokeWidth=2;fontSize=16;fontColor=#1E1E1E;" parent="1" vertex="1"><mxGeometry x="2370" y="545" width="190" height="90" as="geometry" /></mxCell><mxCell id="repn" value="PostgreSQL em EC2 (streaming, promovível). Alternativa: RDS/Aurora via replicação lógica&lt;br&gt;&lt;b&gt;[AC22, AC23]&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D6F1DF;strokeColor=#167846;strokeWidth=2;fontSize=12;fontColor=#167846;" parent="1" vertex="1"><mxGeometry x="1800" y="665" width="250" height="125" as="geometry" /></mxCell><mxCell id="erpcn" value="EC2 (Auto Scaling) atrás de ALB; AWS Elastic Disaster Recovery replica os servidores do ERP&lt;br&gt;&lt;b&gt;[AC23]&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D6F1DF;strokeColor=#167846;strokeWidth=2;fontSize=12;fontColor=#167846;" parent="1" vertex="1"><mxGeometry x="2070" y="665" width="250" height="125" as="geometry" /></mxCell><mxCell id="fon" value="Route 53 (health check, TTL baixo) + runbook automatizado no Systems Manager&lt;br&gt;&lt;b&gt;[AC02, AC23]&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D6F1DF;strokeColor=#167846;strokeWidth=2;fontSize=12;fontColor=#167846;" parent="1" vertex="1"><mxGeometry x="2340" y="665" width="300" height="125" as="geometry" /></mxCell><mxCell id="ctas" value="AWS Organizations: contas separadas (workload, backup, logs, segurança); IAM Identity Center + MFA&lt;br&gt;&lt;b&gt;[AC21]&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D6F1DF;strokeColor=#167846;strokeWidth=2;fontSize=12;fontColor=#167846;" parent="1" vertex="1"><mxGeometry x="1800" y="815" width="290" height="125" as="geometry" /></mxCell><mxCell id="mon" value="CloudWatch Synthetics e alarmes de fora do DC; alerta ao plantão (SNS); gatilho de DR definido&lt;br&gt;&lt;b&gt;[AC02, AC09]&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D6F1DF;strokeColor=#167846;strokeWidth=2;fontSize=12;fontColor=#167846;" parent="1" vertex="1"><mxGeometry x="2110" y="815" width="280" height="125" as="geometry" /></mxCell><mxCell id="idn" value="Managed Microsoft AD, Route 53 privado, ACM e Secrets Manager (certificado NF-e)&lt;br&gt;&lt;b&gt;[AC29, AC07]&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D6F1DF;strokeColor=#167846;strokeWidth=2;fontSize=12;fontColor=#167846;" parent="1" vertex="1"><mxGeometry x="2410" y="815" width="230" height="125" as="geometry" /></mxCell><mxCell id="etl" value="ETL e validação" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E1E1E;strokeWidth=2;fontSize=16;fontColor=#1E1E1E;" parent="1" vertex="1"><mxGeometry x="1800" y="1050" width="190" height="90" as="geometry" /></mxCell><mxCell id="dwh" value="Banco analítico de consultas" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E1E1E;strokeWidth=2;fontSize=16;fontColor=#1E1E1E;" parent="1" vertex="1"><mxGeometry x="2070" y="1045" width="230" height="105" as="geometry" /></mxCell><mxCell id="bi" value="Dashboards BI" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E1E1E;strokeWidth=2;fontSize=16;fontColor=#1E1E1E;" parent="1" vertex="1"><mxGeometry x="2380" y="1055" width="200" height="85" as="geometry" /></mxCell><mxCell id="dms" value="AWS DMS (CDC) a partir da réplica → S3 (área bruta) → RDS PostgreSQL ou Redshift (banco analítico)&lt;br&gt;&lt;b&gt;[AC25]&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D6F1DF;strokeColor=#167846;strokeWidth=2;fontSize=12;fontColor=#167846;" parent="1" vertex="1"><mxGeometry x="1800" y="1180" width="350" height="125" as="geometry" /></mxCell><mxCell id="qs" value="QuickSight (ou Power BI) com segurança por linha; pseudonimização no ETL; exportações auditadas&lt;br&gt;&lt;b&gt;[AC25]&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D6F1DF;strokeColor=#167846;strokeWidth=2;fontSize=12;fontColor=#167846;" parent="1" vertex="1"><mxGeometry x="2180" y="1180" width="460" height="125" as="geometry" /></mxCell><mxCell id="bas" value="Bastion: Systems Manager Session Manager (sem porta aberta), contas admin separadas, MFA FIDO2&lt;br&gt;&lt;b&gt;[AC03, AC26]&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D6F1DF;strokeColor=#167846;strokeWidth=2;fontSize=13;fontColor=#167846;" parent="1" vertex="1"><mxGeometry x="360" y="1455" width="330" height="160" as="geometry" /></mxCell><mxCell id="dir" value="Diretório de identidades (AD/IdP) + RBAC; revisão trimestral; desligamento no mesmo dia&lt;br&gt;&lt;b&gt;[AC16]&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D6F1DF;strokeColor=#167846;strokeWidth=2;fontSize=13;fontColor=#167846;" parent="1" vertex="1"><mxGeometry x="714" y="1455" width="330" height="160" as="geometry" /></mxCell><mxCell id="col" value="Coletor de logs on-prem (Wazuh ou Graylog): NTP, 10 alertas iniciais&lt;br&gt;&lt;b&gt;[AC15]&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D6F1DF;strokeColor=#167846;strokeWidth=2;fontSize=13;fontColor=#167846;" parent="1" vertex="1"><mxGeometry x="1068" y="1455" width="330" height="160" as="geometry" /></mxCell><mxCell id="logi" value="Cópia imutável dos logs: S3 Object Lock na conta log-archive + CloudTrail da organização&lt;br&gt;&lt;b&gt;[AC15]&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D6F1DF;strokeColor=#167846;strokeWidth=2;fontSize=13;fontColor=#167846;" parent="1" vertex="1"><mxGeometry x="1422" y="1455" width="330" height="160" as="geometry" /></mxCell><mxCell id="kms" value="KMS: 'chaves protegidas em KMS' (já previsto por eles)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E1E1E;strokeWidth=2;fontSize=13;fontColor=#1E1E1E;" parent="1" vertex="1"><mxGeometry x="1776" y="1455" width="330" height="70" as="geometry" /></mxCell><mxCell 
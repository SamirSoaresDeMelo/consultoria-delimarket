<mxCell id="n_fita" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=9;" value="Fita offline guardada em outro prédio, só por pessoas autorizadas"><mxGeometry x="1450" y="255" width="130" height="75" as="geometry"/></mxCell>

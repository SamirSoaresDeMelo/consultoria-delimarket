<mxCell id="n_zonas" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=9;" value='Rede: não sabemos se hoje é plana (a proposta só cita "segmentação"). Nós definimos 5 zonas em VLANs: usuários · aplicação (ERP) · banco · backup · gestão (admins, com MFA). Entre zonas, só o necessário, com firewall.'><mxGeometry x="790" y="410" width="190" height="170" as="geometry"/></mxCell>
<mxCell id="n_loki" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=9;" value="Central de logs e métricas (ex.: Grafana + Loki): antivírus/EDR, banco, backup e acessos; cópia imutável"><mxGeometry x="390" y="300" width="130" height="90" as="geometry"/></mxCell>
<mxCell id="n_fis" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=9;" value="Sala do servidor de backup com local definido; alarme com aviso mesmo sem ninguém; climatização"><mxGeometry x="220" y="430" width="150" height="110" as="geometry"/></mxCell>
<mxCell id="n_ups" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=9;" value="UPS: desligamento ordenado dos servidores e testes periódicos. Gerador: ATS e combustível"><mxGeometry x="560" y="480" width="200" height="90" as="geometry"/></mxCell>
